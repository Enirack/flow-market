# ==============================================================================
# FlowMarket — variables d'environnement
# Copier ce fichier en .env (racine) et/ou dans apps/<app>/.env.local
# Ne jamais committer de vrai fichier .env
# ==============================================================================

# --- Application ---
NODE_ENV=development

# --- Ports ---
WEB_PORT=3000
ADMIN_PORT=3001
API_PORT=4000

# --- Base de données (PostgreSQL) ---
POSTGRES_USER=flowmarket
POSTGRES_PASSWORD=changeme
POSTGRES_DB=flowmarket
POSTGRES_HOST=localhost
POSTGRES_PORT=5788
DATABASE_URL=postgresql://flowmarket:changeme@localhost:5788/flowmarket?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Meilisearch ---
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=changeme_dev_master_key

# --- Auth / JWT ---
# JWT_ACCESS_SECRET doit faire au moins 16 caractères. Générer une vraie valeur avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=changeme_generate_a_random_secret_of_at_least_16_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------------------
# Les variables ci-dessous seront introduites dans leurs phases respectives
# (paiements en Phase 7, IA en Phase 11). Elles sont documentées ici pour
# référence mais restent vides tant que la fonctionnalité n'est pas implémentée.
# ------------------------------------------------------------------------------

# --- Paiements (Phase 7) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# --- IA (Phase 11) ---
AI_PROVIDER=
AI_API_KEY=
