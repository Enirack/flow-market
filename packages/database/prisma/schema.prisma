generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum Role {
  CLIENT
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ProviderVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ServicePriceType {
  FIXED
  HOURLY
  PACKAGE
}

enum AvailabilityType {
  RECURRING
  EXCEPTION
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentProviderName {
  STRIPE
  FLUTTERWAVE
  CINETPAY
  PAYDUNYA
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentTransactionType {
  INTENT_CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  REFUNDED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  REJECTED
  FAILED
}

enum PayoutMethod {
  BANK_TRANSFER
  MOBILE_MONEY
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponScope {
  ALL
  CATEGORY
  SERVICE
  PROVIDER
}

enum SubscriptionPlanCode {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  NEW_MESSAGE
  NEW_REVIEW
  PAYOUT_PROCESSED
  REFUND_PROCESSED
  SUBSCRIPTION_UPDATED
}

enum ReportTargetType {
  SERVICE
  REVIEW
  USER
  PROVIDER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTIONED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum VerificationTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ==============================================================================
// IDENTITY
// ==============================================================================

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String
  role            Role       @default(CLIENT)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  profile                 Profile?
  provider                Provider?
  bookingsMade            Booking[]           @relation("ClientBookings")
  orders                  Order[]
  reviews                 Review[]
  notifications           Notification[]
  messagesSent            Message[]
  reportsFiled            Report[]            @relation("ReportedBy")
  disputesRaised          Dispute[]           @relation("DisputeRaisedBy")
  auditLogs               AuditLog[]
  conversationsAsClient   Conversation[]      @relation("ConversationClient")
  conversationsAsProvider Conversation[]      @relation("ConversationProvider")
  refreshTokens           RefreshToken[]
  verificationTokens      VerificationToken[]

  @@index([role])
  @@index([status])
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdByIp String?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model VerificationToken {
  id         String                   @id @default(uuid()) @db.Uuid
  userId     String                   @db.Uuid
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String                   @unique
  purpose    VerificationTokenPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime                 @default(now())

  @@index([userId, purpose])
}

model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  avatarUrl String?
  phone     String?
  country   String?
  locale    String   @default("fr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Provider {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  slug         String   @unique
  bio          String?
  ratingAvg    Decimal  @default(0) @db.Decimal(3, 2)
  ratingCount  Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  verification     ProviderVerification?
  services         Service[]
  availabilities   Availability[]
  bookingsReceived Booking[]             @relation("ProviderBookings")
  reviews          Review[]
  coupons          Coupon[]
  subscription     Subscription?
  balance          ProviderBalance?
  payouts          Payout[]

  @@index([slug])
  @@index([isActive])
}

model ProviderVerification {
  id               String                     @id @default(uuid()) @db.Uuid
  providerId       String                     @unique @db.Uuid
  provider         Provider                   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  status           ProviderVerificationStatus @default(PENDING)
  documents        Json
  rejectionReason  String?
  submittedAt      DateTime                   @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?                    @db.Uuid

  @@index([status])
}

// ==============================================================================
// CATALOGUE
// ==============================================================================

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  parentId    String?    @db.Uuid
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  name        String
  slug        String     @unique
  description String?
  icon        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  services Service[]
  coupons  Coupon[]

  @@index([parentId])
}

model Service {
  id              String           @id @default(uuid()) @db.Uuid
  providerId      String           @db.Uuid
  provider        Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  categoryId      String           @db.Uuid
  category        Category         @relation(fields: [categoryId], references: [id])
  title           String
  slug            String           @unique
  description     String
  priceType       ServicePriceType @default(FIXED)
  basePrice       Decimal          @db.Decimal(12, 2)
  currency        String           @default("XOF")
  durationMinutes Int?
  status          ServiceStatus    @default(DRAFT)
  seoTitle        String?
  seoDescription  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  images       ServiceImage[]
  options      ServiceOption[]
  bookingItems BookingItem[]
  coupons      Coupon[]

  @@index([providerId])
  @@index([categoryId, status])
  @@index([status])
}

model ServiceImage {
  id        String   @id @default(uuid()) @db.Uuid
  serviceId String   @db.Uuid
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([serviceId])
}

model ServiceOption {
  id         String   @id @default(uuid()) @db.Uuid
  serviceId  String   @db.Uuid
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name       String
  priceDelta Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  bookingItems BookingItem[]

  @@index([serviceId])
}

model Availability {
  id           String           @id @default(uuid()) @db.Uuid
  providerId   String           @db.Uuid
  provider     Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  type         AvailabilityType
  weekday      Int?
  specificDate DateTime?
  startTime    String?
  endTime      String?
  isBlocked    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([providerId, type])
}

// ==============================================================================
// RESERVATION & COMMANDE
// ==============================================================================

model Booking {
  id                 String        @id @default(uuid()) @db.Uuid
  clientId           String        @db.Uuid
  client             User          @relation("ClientBookings", fields: [clientId], references: [id])
  providerId         String        @db.Uuid
  provider           Provider      @relation("ProviderBookings", fields: [providerId], references: [id])
  scheduledAt        DateTime
  durationMinutes    Int
  status             BookingStatus @default(PENDING)
  notes              String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  items         BookingItem[]
  order         Order?
  review        Review?
  disputes      Dispute[]
  conversations Conversation[]

  @@index([clientId])
  @@index([providerId, status])
  @@index([scheduledAt])
}

model BookingItem {
  id              String         @id @default(uuid()) @db.Uuid
  bookingId       String         @db.Uuid
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId       String         @db.Uuid
  service         Service        @relation(fields: [serviceId], references: [id])
  serviceOptionId String?        @db.Uuid
  serviceOption   ServiceOption? @relation(fields: [serviceOptionId], references: [id])
  quantity        Int            @default(1)
  unitPrice       Decimal        @db.Decimal(12, 2)
  subtotal        Decimal        @db.Decimal(12, 2)
  createdAt       DateTime       @default(now())

  orderItems OrderItem[]

  @@index([bookingId])
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  bookingId         String      @unique @db.Uuid
  booking           Booking     @relation(fields: [bookingId], references: [id])
  clientId          String      @db.Uuid
  client            User        @relation(fields: [clientId], references: [id])
  couponId          String?     @db.Uuid
  coupon            Coupon?     @relation(fields: [couponId], references: [id])
  subtotalAmount    Decimal     @db.Decimal(12, 2)
  discountAmount    Decimal     @default(0) @db.Decimal(12, 2)
  platformFeeAmount Decimal     @db.Decimal(12, 2)
  providerAmount    Decimal     @db.Decimal(12, 2)
  totalAmount       Decimal     @db.Decimal(12, 2)
  currency          String      @default("XOF")
  status            OrderStatus @default(DRAFT)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]

  @@index([clientId])
  @@index([status])
}

model OrderItem {
  id            String      @id @default(uuid()) @db.Uuid
  orderId       String      @db.Uuid
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookingItemId String      @db.Uuid
  bookingItem   BookingItem @relation(fields: [bookingItemId], references: [id])
  description   String
  quantity      Int
  unitPrice     Decimal     @db.Decimal(12, 2)
  subtotal      Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())

  @@index([orderId])
}

// ==============================================================================
// PAIEMENTS
// ==============================================================================

model Payment {
  id                String              @id @default(uuid()) @db.Uuid
  orderId           String              @db.Uuid
  order             Order               @relation(fields: [orderId], references: [id])
  provider          PaymentProviderName
  providerPaymentId String?
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("XOF")
  status            PaymentStatus       @default(PENDING)
  idempotencyKey    String              @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  transactions PaymentTransaction[]
  refunds      Refund[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([status])
}

model PaymentTransaction {
  id              String                 @id @default(uuid()) @db.Uuid
  paymentId       String                 @db.Uuid
  payment         Payment                @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type            PaymentTransactionType
  providerEventId String?
  amount          Decimal                @db.Decimal(12, 2)
  rawPayload      Json
  createdAt       DateTime               @default(now())

  @@unique([paymentId, providerEventId])
  @@index([paymentId])
}

model Refund {
  id                String       @id @default(uuid()) @db.Uuid
  paymentId         String       @db.Uuid
  payment           Payment      @relation(fields: [paymentId], references: [id])
  amount            Decimal      @db.Decimal(12, 2)
  currency          String       @default("XOF")
  reason            String?
  status            RefundStatus @default(PENDING)
  providerRefundId  String?
  requestedByUserId String       @db.Uuid
  createdAt         DateTime     @default(now())
  processedAt       DateTime?

  @@index([paymentId])
  @@index([status])
}

model ProviderBalance {
  id              String   @id @default(uuid()) @db.Uuid
  providerId      String   @unique @db.Uuid
  provider        Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  availableAmount Decimal  @default(0) @db.Decimal(12, 2)
  pendingAmount   Decimal  @default(0) @db.Decimal(12, 2)
  currency        String   @default("XOF")
  updatedAt       DateTime @updatedAt
}

model Payout {
  id                 String       @id @default(uuid()) @db.Uuid
  providerId         String       @db.Uuid
  provider           Provider     @relation(fields: [providerId], references: [id])
  amount             Decimal      @db.Decimal(12, 2)
  currency           String       @default("XOF")
  status             PayoutStatus @default(REQUESTED)
  method             PayoutMethod
  destinationDetails Json
  providerPayoutId   String?
  rejectionReason    String?
  requestedAt        DateTime     @default(now())
  processedAt        DateTime?

  @@index([providerId])
  @@index([status])
}

// ==============================================================================
// ABONNEMENTS & PROMOTIONS
// ==============================================================================

model SubscriptionPlan {
  id           String               @id @default(uuid()) @db.Uuid
  code         SubscriptionPlanCode @unique
  name         String
  priceMonthly Decimal              @db.Decimal(12, 2)
  currency     String               @default("XOF")
  features     Json
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  providerId         String             @unique @db.Uuid
  provider           Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  planId             String             @db.Uuid
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status])
}

model Coupon {
  id             String      @id @default(uuid()) @db.Uuid
  code           String      @unique
  type           CouponType
  value          Decimal     @db.Decimal(12, 2)
  scope          CouponScope @default(ALL)
  categoryId     String?     @db.Uuid
  category       Category?   @relation(fields: [categoryId], references: [id])
  serviceId      String?     @db.Uuid
  service        Service?    @relation(fields: [serviceId], references: [id])
  providerId     String?     @db.Uuid
  provider       Provider?   @relation(fields: [providerId], references: [id])
  maxUses        Int?
  usedCount      Int         @default(0)
  minOrderAmount Decimal?    @db.Decimal(12, 2)
  startsAt       DateTime    @default(now())
  expiresAt      DateTime?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  orders Order[]

  @@index([code])
  @@index([providerId])
}

// ==============================================================================
// AVIS
// ==============================================================================

model Review {
  id                  String    @id @default(uuid()) @db.Uuid
  bookingId           String    @unique @db.Uuid
  booking             Booking   @relation(fields: [bookingId], references: [id])
  clientId            String    @db.Uuid
  client              User      @relation(fields: [clientId], references: [id])
  providerId          String    @db.Uuid
  provider            Provider  @relation(fields: [providerId], references: [id])
  rating              Int
  comment             String?
  providerResponse    String?
  providerRespondedAt DateTime?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([providerId])
  @@index([clientId])
}

// ==============================================================================
// MESSAGERIE & NOTIFICATIONS
// ==============================================================================

model Conversation {
  id                 String    @id @default(uuid()) @db.Uuid
  clientId           String    @db.Uuid
  client             User      @relation("ConversationClient", fields: [clientId], references: [id])
  providerId         String    @db.Uuid
  provider           User      @relation("ConversationProvider", fields: [providerId], references: [id])
  bookingId          String?   @db.Uuid
  booking            Booking?  @relation(fields: [bookingId], references: [id])
  clientLastReadAt   DateTime?
  providerLastReadAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  messages Message[]

  @@index([clientId])
  @@index([providerId])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @db.Uuid
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ==============================================================================
// MODERATION & AUDIT
// ==============================================================================

model Report {
  id               String           @id @default(uuid()) @db.Uuid
  reporterId       String           @db.Uuid
  reporter         User             @relation("ReportedBy", fields: [reporterId], references: [id])
  targetType       ReportTargetType
  targetId         String           @db.Uuid
  reason           String
  details          String?
  status           ReportStatus     @default(PENDING)
  reviewedByUserId String?          @db.Uuid
  createdAt        DateTime         @default(now())
  reviewedAt       DateTime?

  @@index([targetType, targetId])
  @@index([status])
}

model Dispute {
  id               String        @id @default(uuid()) @db.Uuid
  bookingId        String        @db.Uuid
  booking          Booking       @relation(fields: [bookingId], references: [id])
  raisedByUserId   String        @db.Uuid
  raisedBy         User          @relation("DisputeRaisedBy", fields: [raisedByUserId], references: [id])
  reason           String
  details          String?
  status           DisputeStatus @default(OPEN)
  resolution       String?
  resolvedByUserId String?       @db.Uuid
  createdAt        DateTime      @default(now())
  resolvedAt       DateTime?

  @@index([bookingId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @db.Uuid
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
}
